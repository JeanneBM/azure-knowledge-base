trigger:
  branches:
    include:
      - main

pool:
  vmImage: 'ubuntu-latest'

variables:
  - group: pipeline-creation-vars  # Grupa zmiennych zawierająca PAT
  - name: organization
    value: 'your-organization'    # Nazwa organizacji w Azure DevOps (np. 'myorg')
  - name: project
    value: 'your-project'         # Nazwa projektu w Azure DevOps (np. 'MyProject')
  - name: repositoryId
    value: 'your-repo-id'         # ID repozytorium (można znaleźć w API lub UI)

steps:
  - checkout: self
    persistCredentials: true

  - script: |
      echo "Creating pipelines using Azure DevOps REST API..."

      # Funkcja do tworzenia pipeline'u
      create_pipeline() {
        local pipeline_name=$1
        local yaml_path=$2

        curl -X POST \
          -H "Authorization: Basic $(echo -n ":$(PAT)" | base64)" \
          -H "Content-Type: application/json" \
          -d '{
            "name": "'"$pipeline_name"'",
            "configuration": {
              "type": "yaml",
              "path": "'"$yaml_path"'",
              "repository": {
                "id": "$(repositoryId)",
                "type": "azureReposGit"
              }
            }
          }' \
          "https://dev.azure.com/$(organization)/$(project)/_apis/pipelines?api-version=7.1-preview.1"
        
        # Oddziel odpowiedź od kodu HTTP
        http_code=$(echo "$response" | tail -n1)
        response_body=$(echo "$response" | sed -e '$d')

        echo "HTTP Status: $http_code for $pipeline_name"
        echo "Response: $response_body"

        # Sprawdź, czy żądanie się powiodło
        if [ "$http_code" -ne 200 ]; then
          echo "Error: Failed to create pipeline $pipeline_name (HTTP $http_code)"
          exit 1
        fi

        # Wyodrębnij definitionId z odpowiedzi JSON
        pipeline_id=$(echo "$response_body" | jq -r '.id')
        if [ -z "$pipeline_id" ] || [ "$pipeline_id" = "null" ]; then
          echo "Error: Could not extract pipeline ID for $pipeline_name"
          exit 1
        fi

        # Wypisz adres URL pipeline'u
        pipeline_url="https://dev.azure.com/$(organization)/$(project)/_build?definitionId=$pipeline_id"
        echo "New pipeline created: $pipeline_url"
      }

      # Tworzenie pipeline'ów
      create_pipeline "Pipeline1" "pipeline1.yml"
      create_pipeline "Pipeline2" "pipeline2.yml"
      create_pipeline "Pipeline3" "pipeline3.yml"
    displayName: 'Create Pipelines via REST API'
    env:
      PAT: $(PAT)  # Użycie zmiennej PAT z grupy zmiennych
